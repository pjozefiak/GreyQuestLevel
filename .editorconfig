root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
# Spaces, matching GrayQuestLevel.lua. The template this came from used tabs.
indent_style = space
indent_size = 4

[*.{toc,xml,json,yml,yaml}]
indent_style = space
indent_size = 2
